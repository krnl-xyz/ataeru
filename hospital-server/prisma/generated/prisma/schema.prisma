// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  USER
  MEDICAL_FACILITY
}

model Facility {
  id           String @id @default(uuid())
  facilityName String
  facilityId   String
  npi          Int
  city         String
  zip          String
  state        String
  year         Int
}

model QualityReport {
  facilityId            String   @unique
  facilityName          String
  msa                   Int
  msaTitle              String
  hlmr                  Int
  hlmrPercentile        Int
  hcahpsStartDate       DateTime
  hcahpsEndDate         DateTime
  compHipKnee           Int
  compHipKneePercentile Int
  compStartDate         DateTime
  compEndDate           DateTime
  compFootnote          Int
  proStartDate          DateTime
  proEndDate            DateTime
}

model HcahpsHospitalSurvery {
  facilityId          String   @unique
  facilityName        String
  address             String
  city                String
  zip                 String
  state               String
  telephone           String
  measureId           String
  question            String
  response            String
  hcahpsAnswerPercen  String
  completedSurveys    Int
  responseRatePercent Int
  startDate           DateTime
  endDate             DateTime
}

model HospitalInformation {
  facilityId                    String  @id
  facilityName                  String
  address                       String
  city                          String
  zip                           String
  state                         String
  country                       String
  telephone                     String
  hospitalType                  String
  hospitalOwnership             String
  hospitalOverallRating         String
  hospitalOverallRatingFootnote String?
  emergencyServices             String
  users                         User[]
}

model User {
  id                 String               @id @default(uuid())
  fullname           String
  email              String               @unique
  password           String
  witnesshash        String               @unique
  phone              String
  address            String
  about              String?
  userType           UserType             @default(USER)
  hospitalId         String? // Optional for MEDICAL_FACILITY users
  hospital           HospitalInformation? @relation(fields: [hospitalId], references: [facilityId], onDelete: Cascade)
  registeredHospital Hospital? // Hospital registered by MEDICAL_FACILITY users
  bookings           Booking[] // Bookings made by this user
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Hospital {
  id            String    @id @default(uuid())
  name          String
  location      String
  rating        Float     @default(0)
  specialties   String[] // Array of specialties
  imageUrl      String?
  isFavorite    Boolean   @default(false)
  reviews       Int       @default(0)
  verified      Boolean   @default(false)
  walletAddress String // Owner/admin wallet address
  ownerId       String    @unique // User ID of the owner (MEDICAL_FACILITY user)
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id              String   @id @default(uuid())
  hospitalId      String // Reference to Hospital
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId          String // Reference to User who made the booking
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentDate DateTime // Appointment date and time combined
  duration        Int      @default(30) // Duration in minutes
  purpose         String // Purpose of the appointment (required)
  additionalNotes String? // Additional notes (optional)
  status          String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
